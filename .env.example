# Salin ke .env dan isi nilainya. JANGAN commit .env.

# Wajib. Minimal 32 karakter. Semua service harus memakai nilai yang sama.
# Bangkitkan dengan: openssl rand -base64 48
JWT_SECRET=

# Midtrans (sandbox). Ambil dari dashboard Midtrans.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Akun admin pertama, dibuat otomatis saat user-service start.
ADMIN_EMAIL=admin@tripnest.local
ADMIN_PASSWORD=

# Origin frontend yang diizinkan (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:3000

# Kebijakan booking
BOOKING_EXPIRY_MINUTES=15
BOOKING_EXPIRY_INTERVAL_SECONDS=60
